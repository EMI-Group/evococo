# --- LLM Provider Selection ---
# Switch this to 'zhipu', 'deepseek-v4-pro', 'gemini', or 'custom'
ACTIVE_LLM_PROVIDER=zhipu

# --- Global LLM Settings ---
OPENAI_TEMPERATURE=0.2
NUM_BRANCHES=6

# --- API Keys ---
# Replace placeholder values with your actual API keys
ZHIPU_API_KEY=your_zhipu_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CUSTOM_API_KEY=your_custom_api_key_here

# --- Optional API Base URLs ---
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CUSTOM_BASE_URL=http://localhost:4000/v1

# --- Optional API Model Overrides ---
# Uncomment and set if you wish to override default models
# ZHIPU_MODEL=GLM-5.1
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# GEMINI_MODEL=gemini-3-flash-preview
# CUSTOM_MODEL=custom-model

# --- LLM Provider Selection ---
# Switch this to 'zhipu', 'deepseek-v4-pro', 'deepseek-v4-flash', 'gemini', or 'custom'
ACTIVE_LLM_PROVIDER=gemini

# --- Global LLM Settings ---
OPENAI_TEMPERATURE=0.2
NUM_BRANCHES=6
# Opt in only for a custom Gemini gateway supporting cache_control (e.g. LiteLLM).
# Caches the shared Coder prefix for 300 seconds; ignored for other providers/models.
GEMINI_EXPLICIT_CACHE=0
# Reuse completed analyst reports for identical input, prompts, and model settings.
# Set to 0 for independent analyses or to bypass the local result cache.
ANALYST_RESULT_CACHE=1
# Optional override. The Gemini provider defaults to 'minimal'; all other providers default to 'low'.
# REASONING_EFFORT=high
# Analyst-only override. DeepSeek defaults to high here; other providers inherit REASONING_EFFORT.
# This also partitions the local analyst report cache by the effective effort.
# ANALYST_REASONING_EFFORT=high

# --- Web Interface ---
# A random connection token is printed with the launch URL at each backend start.
# Set a private token here to keep browser connections working across restarts.
# EVOCOCO_WS_TOKEN=replace_with_a_long_random_secret
# Optional additional exact browser origins (comma-separated); no wildcards.
# EVOCOCO_ALLOWED_ORIGINS=http://localhost:5500

# --- API Keys ---
# Replace placeholder values with your actual API keys
ZHIPU_API_KEY=your_zhipu_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CUSTOM_API_KEY=your_custom_api_key_here

# --- Optional API Base URLs ---
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CUSTOM_BASE_URL=http://localhost:4000/v1

# --- Optional API Model Overrides ---
# Uncomment and set if you wish to override default models
# ZHIPU_MODEL=GLM-5.1
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# GEMINI_MODEL=gemini-3-flash-preview
# CUSTOM_MODEL=custom-model
